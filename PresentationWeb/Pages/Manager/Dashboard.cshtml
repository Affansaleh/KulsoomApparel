@page "/Manager/Dashboard"
@model DashboardModel
@using System.Text.Json

@{
    ViewData["Title"] = "Manager Dashboard";
    var dept = Model.Department;

    var articleDetailsJson =
        JsonSerializer.Serialize(
            Model.ArticleDetails,
            new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            });

    var statusesJson =
        JsonSerializer.Serialize(
            Model.Statuses,
            new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            });
}

@await Html.PartialAsync("_Navbar")
@Html.AntiForgeryToken()

<div class="container-fluid px-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">
            @(dept?.Name ?? "Department") Dashboard
        </h4>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header">
            Work Queue
        </div>

        <div class="card-body table-responsive">
            @if (Model.Statuses.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Article</th>
                            <th>Company</th>
                            <th>Delivery</th>
                            <th>Input</th>
                            <th>Output</th>
                            <th>Loss</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var s in Model.Statuses)
                        {
                            var badge = s.Status switch
                            {
                                "Done" => "text-bg-success",
                                "InProcess" => "text-bg-warning",
                                _ => "text-bg-secondary"
                            };

                            <tr data-status-id="@s.Id"
                                data-article-id="@s.ArticleId">

                                <td class="fw-semibold">
                                    @s.ArticleCode

                                    @if (s.IsPinned)
                                    {
                                        <span class="bi bi-pin-fill text-warning"></span>
                                    }
                                </td>

                                <td>
                                    @s.CompanyName
                                </td>

                                <td>
                                    @(s.DeliveryDate?.ToString("dd MMM yyyy") ?? "—")
                                </td>

                                <td>
                                    @(s.InputQuantity?.ToString() ?? "—")
                                </td>

                                <td>
                                    @(s.OutputQuantity?.ToString() ?? "—")
                                </td>

                                <td>
                                    @(s.LossQuantity?.ToString() ?? "—")
                                </td>

                                <td>
                                    <span class="badge @badge">
                                        @s.Status
                                    </span>
                                </td>

                                <td class="text-end text-nowrap">
                                    @if (Model.ArticleDetails.ContainsKey(s.ArticleId))
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-info btn-view-fabrics"
                                                data-article="@s.ArticleId">
                                            <span class="bi bi-box-seam me-1"></span>
                                            Fabrics
                                        </button>
                                    }

                                    @if (Model.DepartmentType == Domain.Enums.DepartmentType.Delivery &&
                                         Model.ArticleDetails.ContainsKey(s.ArticleId))
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary btn-view-sizes"
                                                data-article="@s.ArticleId">
                                            <span class="bi bi-list-columns me-1"></span>
                                            View Sizes
                                        </button>
                                    }

                                    @if (s.Status == "Pending")
                                    {
                                        @if (Model.DepartmentType == Domain.Enums.DepartmentType.Stitching)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary btn-start-team"
                                                    data-id="@s.Id">
                                                Start
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary btn-start"
                                                    data-id="@s.Id">
                                                Start
                                            </button>
                                        }
                                    }
                                    else if (s.Status == "InProcess")
                                    {
                                        @if (Model.DepartmentType == Domain.Enums.DepartmentType.QualityAndPacking)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-success btn-quality"
                                                    data-article="@s.ArticleId"
                                                    data-input="@(s.InputQuantity ?? 0)">
                                                End
                                            </button>
                                        }
                                        else if (Model.DepartmentType == Domain.Enums.DepartmentType.Delivery)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-success btn-delivery"
                                                    data-article="@s.ArticleId">
                                                Deliver
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-success btn-end"
                                                    data-id="@s.Id"
                                                    data-input="@(s.InputQuantity?.ToString() ?? "")">
                                                End
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            Done
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">
                    No pending work in your department.
                </p>
            }
        </div>
    </div>
</div>

<!-- Generic Start modal -->
<div class="modal fade"
     id="startModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="Start">

                <input type="hidden"
                       name="statusId"
                       id="startStatusId" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        Start Work
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Start work on this department?
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Start
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Stitching Start modal -->
<div class="modal fade"
     id="startTeamModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="Start">

                <input type="hidden"
                       name="statusId"
                       id="startTeamStatusId" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        Start Stitching
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <label class="form-label">
                        Select Team
                    </label>

                    <select name="teamId"
                            class="form-select"
                            required>

                        <option value="">
                            Choose team...
                        </option>

                        @foreach (var t in Model.Teams)
                        {
                            <option value="@t.Id">
                                @t.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Start
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Generic End Work modal -->
<div class="modal fade"
     id="endModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="End">

                <input type="hidden"
                       name="statusId"
                       id="endStatusId" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        End Work
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    @if (Model.DepartmentType is
                        Domain.Enums.DepartmentType.Pattern or
                        Domain.Enums.DepartmentType.Sampling)
                    {
                        <p class="text-muted small mb-2">
                            No quantity entry is required for this department.
                        </p>

                        <div class="mb-2">
                            <label class="form-label">
                                Note
                            </label>

                            <textarea name="note"
                                      class="form-control"
                                      rows="2">
                            </textarea>
                        </div>
                    }
                    else
                    {
                        <div class="mb-2">
                            <label class="form-label">
                                Output Quantity
                            </label>

                            <input type="number"
                                   name="outputQty"
                                   min="0"
                                   max=""
                                   step="1"
                                   inputmode="numeric"
                                   class="form-control"
                                   id="endOutputQty" />

                            <div class="form-text small"
                                 id="endQtyHint">
                            </div>
                        </div>

                        @if (Model.DepartmentType ==
                            Domain.Enums.DepartmentType.Stitching)
                        {
                            <div class="mb-2">
                                <label class="form-label">
                                    Stitched By (Name)
                                    <span class="text-danger">*</span>
                                </label>

                                <input type="text"
                                       name="stitchedBy"
                                       class="form-control"
                                       required />
                            </div>
                        }

                        <div class="mb-2">
                            <label class="form-label">
                                Note
                            </label>

                            <textarea name="note"
                                      class="form-control"
                                      rows="2">
                            </textarea>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        End Work
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Quality & Packing modal -->
<div class="modal fade"
     id="qualityModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="Quality">

                <input type="hidden"
                       name="articleId"
                       id="qualityArticleId" />

                <input type="hidden"
                       name="sizeLabels"
                       id="qualitySizeLabels" />

                <input type="hidden"
                       name="quantities"
                       id="qualityQuantities" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        Quality &amp; Packing — Grades
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="text-muted small mb-2">
                        Enter whole-number quantities for the applicable sizes.
                    </p>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Size</th>
                                    <th style="width:140px;">
                                        A-Grade Quantity
                                    </th>
                                </tr>
                            </thead>

                            <tbody id="qualitySizeRows">
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th>Total A-Grade</th>
                                    <th id="qualityGrandTotal">
                                        0
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="row g-2 mt-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                B-Grade Quantity
                            </label>

                            <input type="text"
                                   name="bGrade"
                                   id="qualityBGrade"
                                   class="form-control"
                                   value=""
                                   inputmode="numeric"
                                   pattern="[0-9]*" />

                            <div class="form-text small"
                                 id="qualityBGradeHint">
                                Maximum depends on A-Grade total.
                            </div>
                        </div>
                    </div>

                    <div id="qualityReview"
                         class="alert alert-info d-none mt-3 mb-0">

                        <strong>
                            Confirmed Table Review
                        </strong>

                        <div id="qualityReviewText"
                             class="small mt-1">
                        </div>
                    </div>

                    <div id="qualityNoteWrap"
                         class="mt-3 d-none">

                        <label class="form-label">
                            Note
                        </label>

                        <textarea name="note"
                                  id="qualityNote"
                                  class="form-control"
                                  rows="2">
                        </textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary d-none"
                            id="qualityBack">
                        Back / Edit
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            id="qualitySubmit">
                        Confirm Table
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Article Fabrics read-only modal -->
<div class="modal fade"
     id="fabricViewModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Article Fabrics
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <div class="table-responsive"
                     id="managerFabricTableWrapper">

                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fabric Code</th>
                                <th>Fabric Type</th>
                                <th>Invoice</th>
                                <th>Used Quantity</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody id="managerFabricRows">
                        </tbody>
                    </table>
                </div>

                <p id="managerNoFabrics"
                   class="text-muted mb-0 d-none">
                    No fabrics linked to this article.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Read-only Size Table modal -->
<div class="modal fade"
     id="sizeViewModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Quality &amp; Packing Size Table
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <p class="text-muted small">
                    This table is read-only. It shows the quantities entered by
                    Quality &amp; Packing.
                </p>

                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Size</th>
                                <th>A-Grade Quantity</th>
                            </tr>
                        </thead>

                        <tbody id="managerSizeRows">
                        </tbody>

                        <tfoot>
                            <tr>
                                <th>Total A-Grade</th>
                                <th id="managerAGradeTotal">0</th>
                            </tr>

                            <tr>
                                <th>B-Grade</th>
                                <th id="managerBGradeTotal">0</th>
                            </tr>

                            <tr class="table-primary">
                                <th>Total Output</th>
                                <th id="managerTotalOutput">0</th>
                            </tr>

                            <tr class="table-warning">
                                <th>Loss</th>
                                <th id="managerQualityLoss">0</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <p id="managerNoSizes"
                   class="text-muted mb-0 d-none">
                    No size breakdown has been entered yet.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delivery confirmation modal -->
<div class="modal fade"
     id="deliveryModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="Delivery">

                <input type="hidden"
                       name="articleId"
                       id="deliveryArticleId" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        Confirm Delivery
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">
                            Packed By
                        </label>

                        <input type="text"
                               name="packedBy"
                               class="form-control" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">
                            Checked By
                        </label>

                        <input type="text"
                               name="checkedBy"
                               class="form-control" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">
                            No. of Cartons
                        </label>

                        <input type="number"
                               name="noOfCartons"
                               min="0"
                               class="form-control" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">
                            Note
                        </label>

                        <textarea name="note"
                                  class="form-control"
                                  rows="2">
                        </textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            id="deliverySizesButton"
                            class="btn btn-outline-info">
                        <span class="bi bi-list-columns me-1"></span>
                        View Size Table
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Confirm Delivery
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const articleDetails =
                @Html.Raw(articleDetailsJson);

            const currentStatuses =
                @Html.Raw(statusesJson);

            const SIZES = [
                "0-3 M",
                "3-6 M",
                "6-9 M",
                "9-12 M",
                "12-18 M",
                "18-24 M",
                "1-2 Y",
                "2-3 Y",
                "3-4 Y",
                "4-5 Y",
                "5-6 Y",
                "6-7 Y",
                "7-8 Y",
                "9-10 Y",
                "11-12 Y",
                "13-14 Y"
            ];

            function getArticleDetails(articleId) {
                return articleDetails[String(articleId)]
                    || articleDetails[articleId]
                    || null;
            }

            function escapeHtml(value) {
                const div = document.createElement("div");
                div.textContent = value ?? "";
                return div.innerHTML;
            }

            // Generic Start
            document
                .querySelectorAll(".btn-start")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        document.getElementById("startStatusId").value =
                            button.getAttribute("data-id");

                        new bootstrap.Modal(
                            document.getElementById("startModal")
                        ).show();
                    });
                });

            // Stitching Start
            document
                .querySelectorAll(".btn-start-team")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        document.getElementById("startTeamStatusId").value =
                            button.getAttribute("data-id");

                        new bootstrap.Modal(
                            document.getElementById("startTeamModal")
                        ).show();
                    });
                });

            // Generic End
            document
                .querySelectorAll(".btn-end")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const statusId =
                            button.getAttribute("data-id");

                        const inputValue =
                            button.getAttribute("data-input") || "";

                        const outputInput =
                            document.getElementById("endOutputQty");

                        const hint =
                            document.getElementById("endQtyHint");

                        document.getElementById("endStatusId").value =
                            statusId;

                        if (hint) {
                            hint.textContent =
                                inputValue
                                    ? "Input: " + inputValue
                                    : "";
                        }

                        const isCutting =
                            "@Model.DepartmentType" === "Cutting";

                        if (outputInput) {
                            outputInput.value = "";

                            // Cutting has no maximum restriction.
                            outputInput.max =
                                isCutting
                                    ? ""
                                    : inputValue;
                        }

                        new bootstrap.Modal(
                            document.getElementById("endModal")
                        ).show();
                    });
                });

            // Quality modal open
            document
                .querySelectorAll(".btn-quality")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const articleId =
                            button.getAttribute("data-article");

                        const inputQuantity =
                            button.getAttribute("data-input") || "0";

                        document.getElementById("qualityArticleId").value =
                            articleId;

                        document
                            .getElementById("qualityModal")
                            .dataset.input = inputQuantity;

                        renderQualitySizes();

                        new bootstrap.Modal(
                            document.getElementById("qualityModal")
                        ).show();
                    });
                });

            function qualityKey() {
                return "quality-sizes-" +
                    document.getElementById("qualityArticleId").value;
            }

            function loadSavedQualityValues() {
                try {
                    return JSON.parse(
                        sessionStorage.getItem(qualityKey()) || "{}"
                    );
                }
                catch {
                    return {};
                }
            }

            function renderQualitySizes() {
                const tbody =
                    document.getElementById("qualitySizeRows");

                const saved =
                    loadSavedQualityValues();

                tbody.innerHTML = "";

                SIZES.forEach(function (size) {
                    const row =
                        document.createElement("tr");

                    const savedValue =
                        saved[size] ?? "";

                    row.innerHTML =
                        "<td class=\"fw-semibold\">" +
                        escapeHtml(size) +
                        "</td>" +
                        "<td>" +
                        "<input type=\"text\" " +
                        "class=\"form-control form-control-sm size-qty\" " +
                        "data-size=\"" + escapeHtml(size) + "\" " +
                        "value=\"" + escapeHtml(savedValue) + "\" " +
                        "inputmode=\"numeric\" " +
                        "pattern=\"[0-9]*\" />" +
                        "</td>";

                    const input =
                        row.querySelector(".size-qty");

                    input.addEventListener(
                        "input",
                        function () {
                            this.value =
                                this.value.replace(/[^0-9]/g, "");

                            saveQualityValues();
                            updateGrandTotal();
                        });

                    tbody.appendChild(row);
                });

                const bGrade =
                    document.getElementById("qualityBGrade");

                bGrade.value =
                    sessionStorage.getItem(
                        qualityKey() + "-b"
                    ) || "";

                bGrade.oninput = function () {
                    this.value =
                        this.value.replace(/[^0-9]/g, "");

                    sessionStorage.setItem(
                        qualityKey() + "-b",
                        this.value
                    );
                };

                updateGrandTotal();

                document
                    .getElementById("qualityReview")
                    .classList.add("d-none");

                document
                    .getElementById("qualityNoteWrap")
                    .classList.add("d-none");

                document
                    .getElementById("qualityBack")
                    .classList.add("d-none");

                document
                    .querySelectorAll(
                        "#qualitySizeRows input, #qualityBGrade"
                    )
                    .forEach(function (input) {
                        input.readOnly = false;
                    });

                document
                    .getElementById("qualitySubmit")
                    .textContent = "Confirm Table";

                document
                    .getElementById("qualitySubmit")
                    .onclick = confirmQualityTable;
            }

            function saveQualityValues() {
                const saved = {};

                document
                    .querySelectorAll(".size-qty")
                    .forEach(function (input) {
                        saved[input.dataset.size] =
                            input.value;
                    });

                sessionStorage.setItem(
                    qualityKey(),
                    JSON.stringify(saved)
                );
            }

            function updateGrandTotal() {
                let aGradeTotal = 0;

                document
                    .querySelectorAll(".size-qty")
                    .forEach(function (input) {
                        aGradeTotal +=
                            Number(input.value) || 0;
                    });

                document
                    .getElementById("qualityGrandTotal")
                    .textContent = aGradeTotal;

                const inputQuantity =
                    Number(
                        document
                            .getElementById("qualityModal")
                            .dataset.input || 0
                    );

                const maximumBGrade =
                    Math.max(0, inputQuantity - aGradeTotal);

                const bGrade =
                    document.getElementById("qualityBGrade");

                bGrade.max =
                    maximumBGrade;

                document
                    .getElementById("qualityBGradeHint")
                    .textContent =
                    "Maximum B-Grade: " + maximumBGrade;
            }

            function confirmQualityTable() {
                saveQualityValues();

                const inputQuantity =
                    Number(
                        document
                            .getElementById("qualityModal")
                            .dataset.input || 0
                    );

                let aGradeTotal = 0;

                document
                    .querySelectorAll(".size-qty")
                    .forEach(function (input) {
                        aGradeTotal +=
                            Number(input.value) || 0;
                    });

                const bGradeInput =
                    document.getElementById("qualityBGrade");

                const bGradeTotal =
                    bGradeInput.value.trim() === ""
                        ? 0
                        : Number(bGradeInput.value) || 0;

                const totalOutput =
                    aGradeTotal + bGradeTotal;

                if (totalOutput > inputQuantity) {
                    const maximumBGrade =
                        Math.max(
                            0,
                            inputQuantity - aGradeTotal
                        );

                    showToast(
                        "Invalid quantity. A-Grade is " +
                        aGradeTotal +
                        ". B-Grade can be maximum " +
                        maximumBGrade +
                        ". Total cannot exceed " +
                        inputQuantity +
                        ". Nothing was saved.",
                        "error"
                    );

                    document
                        .querySelectorAll(
                            "#qualitySizeRows input, #qualityBGrade"
                        )
                        .forEach(function (input) {
                            input.readOnly = false;
                        });

                    document
                        .getElementById("qualityReview")
                        .classList.add("d-none");

                    document
                        .getElementById("qualityNoteWrap")
                        .classList.add("d-none");

                    document
                        .getElementById("qualityBack")
                        .classList.add("d-none");

                    document
                        .getElementById("qualitySubmit")
                        .textContent = "Confirm Table";

                    document
                        .getElementById("qualitySubmit")
                        .onclick = confirmQualityTable;

                    return;
                }

                const values =
                    Array.from(
                        document.querySelectorAll(".size-qty")
                    )
                    .filter(function (input) {
                        return input.value.trim() !== "";
                    })
                    .map(function (input) {
                        return input.dataset.size +
                            ": " +
                            input.value;
                    });

                document
                    .getElementById("qualityReviewText")
                    .textContent =
                    (values.length
                        ? values.join(", ")
                        : "No A-Grade sizes entered") +
                    " | B-Grade: " +
                    bGradeTotal +
                    " | Total Output: " +
                    totalOutput;

                document
                    .getElementById("qualityReview")
                    .classList.remove("d-none");

                document
                    .getElementById("qualityNoteWrap")
                    .classList.remove("d-none");

                document
                    .getElementById("qualityBack")
                    .classList.remove("d-none");

                document
                    .querySelectorAll(
                        "#qualitySizeRows input, #qualityBGrade"
                    )
                    .forEach(function (input) {
                        // readonly fields are still submitted with the form.
                        input.readOnly = true;
                    });

                document
                    .getElementById("qualitySubmit")
                    .textContent = "End Work";

                document
                    .getElementById("qualitySubmit")
                    .onclick = submitQuality;
            }

            function submitQuality() {
                const labels = [];
                const quantities = [];

                document
                    .querySelectorAll(".size-qty")
                    .forEach(function (input) {
                        labels.push(input.dataset.size);
                        quantities.push(input.value || "0");
                    });

                document
                    .getElementById("qualitySizeLabels")
                    .value = labels.join("|");

                document
                    .getElementById("qualityQuantities")
                    .value = quantities.join("|");

                document
                    .getElementById("qualityModal")
                    .querySelector("form")
                    .submit();
            }

            document
                .getElementById("qualityBack")
                .addEventListener("click", function () {
                    document
                        .querySelectorAll(
                            "#qualitySizeRows input, #qualityBGrade"
                        )
                        .forEach(function (input) {
                            input.readOnly = false;
                        });

                    document
                        .getElementById("qualityReview")
                        .classList.add("d-none");

                    document
                        .getElementById("qualityNoteWrap")
                        .classList.add("d-none");

                    this.classList.add("d-none");

                    document
                        .getElementById("qualitySubmit")
                        .textContent = "Confirm Table";

                    document
                        .getElementById("qualitySubmit")
                        .onclick = confirmQualityTable;
                });

            // Fabric read-only modal
            document
                .querySelectorAll(".btn-view-fabrics")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        showFabricModal(
                            button.getAttribute("data-article")
                        );
                    });
                });

            function showFabricModal(articleId) {
                const article =
                    getArticleDetails(articleId);

                const tbody =
                    document.getElementById("managerFabricRows");

                const emptyMessage =
                    document.getElementById("managerNoFabrics");

                tbody.innerHTML = "";

                if (!article ||
                    !article.fabrics ||
                    article.fabrics.length === 0) {
                    emptyMessage.classList.remove("d-none");
                }
                else {
                    emptyMessage.classList.add("d-none");

                    article.fabrics.forEach(function (fabric) {
                        const row =
                            document.createElement("tr");

                        const status =
                            fabric.status === "OutOfStock"
                                ? '<span class="badge text-bg-danger">Out Of Stock</span>'
                                : '<span class="badge text-bg-success">In Stock</span>';

                        row.innerHTML =
                            "<td>" +
                            escapeHtml(fabric.fabricCode || "—") +
                            "</td>" +
                            "<td>" +
                            escapeHtml(fabric.fabricType || "—") +
                            "</td>" +
                            "<td>" +
                            escapeHtml(fabric.invNum || "—") +
                            "</td>" +
                            "<td>" +
                            escapeHtml(
                                String(fabric.quantityUsed ?? "0")
                            ) +
                            "</td>" +
                            "<td>" +
                            status +
                            "</td>";

                        tbody.appendChild(row);
                    });
                }

                new bootstrap.Modal(
                    document.getElementById("fabricViewModal")
                ).show();
            }

            // Read-only size table modal
            document
                .querySelectorAll(".btn-view-sizes")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        showSizeModal(
                            button.getAttribute("data-article")
                        );
                    });
                });

            function showSizeModal(articleId) {
                const article =
                    getArticleDetails(articleId);

                const tbody =
                    document.getElementById("managerSizeRows");

                const emptyMessage =
                    document.getElementById("managerNoSizes");

                tbody.innerHTML = "";

                const aGradeTotal =
                    article?.aGradeQuantity ?? 0;

                const bGradeTotal =
                    article?.bGradeQuantity ?? 0;

                const totalOutput =
                    aGradeTotal + bGradeTotal;

                const status =
                    currentStatuses.find(function (item) {
                        return String(item.articleId) ===
                            String(articleId) &&
                            (item.departmentName || "")
                                .toLowerCase() ===
                            "quality & packing";
                    });

                const loss =
                    status?.lossQuantity ?? 0;

                document
                    .getElementById("managerAGradeTotal")
                    .textContent = aGradeTotal;

                document
                    .getElementById("managerBGradeTotal")
                    .textContent = bGradeTotal;

                document
                    .getElementById("managerTotalOutput")
                    .textContent = totalOutput;

                document
                    .getElementById("managerQualityLoss")
                    .textContent = loss;

                if (!article ||
                    !article.sizeBreakdowns ||
                    article.sizeBreakdowns.length === 0) {
                    emptyMessage.classList.remove("d-none");
                }
                else {
                    emptyMessage.classList.add("d-none");

                    article.sizeBreakdowns
                        .slice()
                        .sort(function (a, b) {
                            return a.orderIndex - b.orderIndex;
                        })
                        .forEach(function (size) {
                            const row =
                                document.createElement("tr");

                            row.innerHTML =
                                "<td>" +
                                escapeHtml(size.sizeLabel) +
                                "</td>" +
                                "<td>" +
                                String(size.quantity) +
                                "</td>";

                            tbody.appendChild(row);
                        });
                }

                new bootstrap.Modal(
                    document.getElementById("sizeViewModal")
                ).show();
            }

            // Delivery
            document
                .querySelectorAll(".btn-delivery")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const articleId =
                            button.getAttribute("data-article");

                        document
                            .getElementById("deliveryArticleId")
                            .value = articleId;

                        new bootstrap.Modal(
                            document.getElementById("deliveryModal")
                        ).show();
                    });
                });

            document
                .getElementById("deliverySizesButton")
                .addEventListener("click", function () {
                    const articleId =
                        document
                            .getElementById("deliveryArticleId")
                            .value;

                    if (articleId) {
                        showSizeModal(articleId);
                    }
                });
        })();
    </script>
}