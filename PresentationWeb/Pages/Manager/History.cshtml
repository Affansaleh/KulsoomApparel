@page "/Manager/History"
@model HistoryModel
@{
    ViewData["Title"] = "History";
}

@await Html.PartialAsync("_Navbar")

<div class="container-fluid px-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">History — My Completed Work</h4>
        <a asp-page="/Manager/Dashboard" class="btn btn-outline-secondary btn-sm"><span class="bi bi-arrow-left"></span> Back to Dashboard</a>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Search</label>
                    <input type="text" class="form-control" id="historySearch" placeholder="Search by article code or company..." autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Completed From</label>
                    <input type="date" class="form-control" id="historyFrom" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Completed To</label>
                    <input type="date" class="form-control" id="historyTo" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" id="btnResetHistory">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Article</th>
                        <th>Company</th>
                        <th>Colour</th>
                        <th>Fabric(s)</th>
                        <th>Qty</th>
                        <th>Delivery</th>
                        <th>Completed</th>
                        <th>Status</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody id="historyBody">
                    <tr><td colspan="9" class="text-center text-muted py-4">Loading…</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const apiBase = '@Url.Page("History", "Articles")';
        const tbody = document.getElementById('historyBody');

        async function load() {
            const search = document.getElementById('historySearch').value.trim();
            const from = document.getElementById('historyFrom').value;
            const to = document.getElementById('historyTo').value;

            tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4">Loading…</td></tr>';

            const url = apiBase
                + '&search=' + encodeURIComponent(search)
                + '&from=' + encodeURIComponent(from)
                + '&to=' + encodeURIComponent(to);
            const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const rows = await res.json();
            render(rows);
        }

        function render(rows) {
            if (!rows.length) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4">No completed work found.</td></tr>';
                return;
            }

            tbody.innerHTML = rows.map(r => {
                const fabrics = r.fabrics || [];
                const fabricCell = fabrics.length
                    ? fabrics.map(f => esc(f.fabricCode)).join(', ')
                    : '—';
                const statusBadge = r.isDelivered
                    ? '<span class="badge text-bg-success">Delivered</span>'
                    : '<span class="badge text-bg-secondary">In Progress</span>';
                return `<tr>
                    <td class="fw-semibold">${esc(r.articleCode)}</td>
                    <td>${esc(r.companyName)}</td>
                    <td>${esc(r.color)}</td>
                    <td>${fabricCell}</td>
                    <td>${r.quantity ?? 0}</td>
                    <td>${formatDate(r.deliveryDate)}</td>
                    <td>${r.deptEndedAt ? formatDate(r.deptEndedAt) : '—'}</td>
                    <td>${statusBadge}</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Manager/ArticleDetail/${r.id}">View</a></td>
                </tr>`;
            }).join('');
        }

        let debounce;
        document.getElementById('historySearch').addEventListener('input', () => {
            clearTimeout(debounce);
            debounce = setTimeout(load, 350);
        });
        document.getElementById('historyFrom').addEventListener('change', load);
        document.getElementById('historyTo').addEventListener('change', load);
        document.getElementById('btnResetHistory').addEventListener('click', () => {
            document.getElementById('historySearch').value = '';
            document.getElementById('historyFrom').value = '';
            document.getElementById('historyTo').value = '';
            load();
        });

        function esc(s) {
            if (!s) return '—';
            const d = document.createElement('div');
            d.textContent = String(s);
            return d.innerHTML;
        }
        function formatDate(iso) {
            if (!iso) return '—';
            const d = new Date(iso);
            return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
        }

        load();
    })();
</script>
}
