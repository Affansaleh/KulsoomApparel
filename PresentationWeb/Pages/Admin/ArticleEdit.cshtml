@page "/Admin/ArticleEdit/{id:int}"
@model ArticleEditModel
@{
    ViewData["Title"] = "Edit Article";
    var seasons = new[] { "Summer", "Winter", "Spring", "Autumn" };
}

@await Html.PartialAsync("_Navbar")

<div class="container-fluid px-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Edit Article — @Model.ArticleCode</h4>
        <a asp-page="/Admin/ArticleDetail" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><span class="bi bi-arrow-left"></span> Back to Detail</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2">@TempData["ErrorMessage"]</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
    }

    <div class="alert alert-warning py-2">
        <span class="bi bi-info-circle me-1"></span>
        Article code and order date cannot be changed after creation.
        Fabric changes are applied only when you press <strong>Save Changes</strong>.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post" onsubmit="return window.buildFabricJson ? window.buildFabricJson() : true;">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ExistingQtyJson" id="existingQtyJson" />
                <input type="hidden" asp-for="RemovedFabricIdsCsv" id="removedFabricIdsCsv" />
                <input type="hidden" asp-for="NewFabricLinksJson" id="newFabricLinksJson" />
                <input type="hidden" asp-for="AddedFabricLinksJson" id="addedFabricLinksJson" />

                <!-- Basic Details -->
                <h6 class="text-muted mb-3">Basic Details</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Company Name <span class="text-danger">*</span></label>
                        <input asp-for="Input.CompanyName" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Article Code</label>
                        <input class="form-control" value="@Model.ArticleCode" disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Colour</label>
                        <input asp-for="Input.Color" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Order Date</label>
                        <input class="form-control" value="@(Model.OrderDate.ToString("yyyy-MM-dd"))" disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Delivery Date <span class="text-danger">*</span></label>
                        <input asp-for="Input.DeliveryDate" type="date" class="form-control" required min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Season</label>
                        <select asp-for="Input.Season" class="form-select">
                            <option value="">Select season</option>
                            @foreach (var s in seasons)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Quantity</label>
                        <input asp-for="Input.Quantity" type="number" min="0" class="form-control" placeholder="Optional" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Price Per Piece</label>
                        <input asp-for="Input.PricePerPiece" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Stitched By (Name)</label>
                        <input asp-for="Input.StitchedBy" class="form-control" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input asp-for="Input.IsPinned" class="form-check-input" />
                            <label class="form-check-label" asp-for="Input.IsPinned">Pinned</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Embellishments -->
                <h6 class="text-muted mb-3">Embellishments</h6>
                <div class="form-check form-check-inline">
                    <input asp-for="Input.EmbellishmentPrinting" class="form-check-input" />
                    <label class="form-check-label" asp-for="Input.EmbellishmentPrinting">Printing</label>
                </div>
                <div class="form-check form-check-inline">
                    <input asp-for="Input.EmbellishmentEmbroidery" class="form-check-input" />
                    <label class="form-check-label" asp-for="Input.EmbellishmentEmbroidery">Embroidery</label>
                </div>
                <div class="form-check form-check-inline">
                    <input asp-for="Input.EmbellishmentHandwork" class="form-check-input" />
                    <label class="form-check-label" asp-for="Input.EmbellishmentHandwork">Hand Work</label>
                </div>
                <div class="text-muted small mt-1">Checking adds the department to the workflow; unchecking removes it (if not yet started).</div>

                <hr class="my-4" />

                <!-- Alternate codes -->
                <h6 class="text-muted mb-3">Alternate Codes</h6>
                <input type="hidden" asp-for="AltCodesCsv" id="altCodesCsv" />
                <div class="row g-2 mb-2">
                    <div class="col-md-12">
                        <div id="altCodeContainer"></div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="addAltCode"><span class="bi bi-plus-lg"></span> Add Code</button>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Existing linked fabrics (editable qty + remove, applied on Save) -->
                @if (Model.ExistingFabrics.Any())
                {
                    <h6 class="text-muted mb-3">Linked Fabrics</h6>
                    <table class="table table-sm align-middle mb-3" style="max-width:800px;" id="existingFabricsTable">
                        <thead>
                            <tr><th>Code</th><th>Type</th><th>Color</th><th>Used Qty</th><th>Status</th><th class="text-end">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.ExistingFabrics)
                            {
                                <tr data-fabric-id="@f.FabricId" data-code="@f.FabricCode">
                                    <td class="fw-semibold">@f.FabricCode</td>
                                    <td>@f.FabricType</td>
                                    <td>@f.Color</td>
                                    <td>
                                        <div class="input-group input-group-sm"><input type="number" step="0.01" min="0" class="form-control form-control-sm ef-qty" value="@f.QuantityUsed" style="width:110px;" /><span class="input-group-text">@f.Unit</span></div>
                                    </td>
                                    <td>
                                        @if (f.Status == "OutOfStock")
                                        {
                                            <span class="badge text-bg-danger">Out Of Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">In Stock</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!Model.CuttingStarted)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger ef-remove" title="Remove fabric"><span class="bi bi-x"></span> Remove</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="text-muted small mb-3">Edit quantities above or press Remove to stage them. Changes apply when you Save.</div>
                }

                @if (Model.CuttingStarted)
                {
                    <div class="alert alert-info py-2">
                        <span class="bi bi-info-circle me-1"></span>
                        Cutting has started — only existing fabric quantities can be adjusted. Fabrics can no longer be added or removed.
                    </div>
                }

                <!-- Add More Fabrics (staged list, applied on Save) — hidden once Cutting has started -->
                @if (!Model.CuttingStarted)
                {
                    <h6 class="text-muted mb-3">Add More Fabrics</h6>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="openFabricPicker">
                            <span class="bi bi-list-check"></span> Select Fabric
                        </button>
                        <button type="button" class="btn btn-outline-success btn-sm" id="openFabricModal">
                            <span class="bi bi-patch-plus"></span> Add New Fabric
                        </button>
                    </div>

                    <div id="newFabricRows"></div>
                    <div class="text-muted small" id="newFabricHint">Search and pick fabrics to add. They will be linked when you Save.</div>

                    <div id="stagedNewFabricRows"></div>
                }

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary"><span class="bi bi-check-lg me-1"></span>Save Changes</button>
                    <a asp-page="/Admin/ArticleDetail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            @{
                    var fabricsJson = System.Text.Json.JsonSerializer.Serialize(
                                                                            Model.Fabrics.Select(f => new { f.Id, f.FabricCode, f.Color, f.FabricType, f.InvNum, f.Unit, f.AvailableQuantity }),
                    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
                }
                        const fabrics = @Html.Raw(fabricsJson);
            @{
                    var existingIdsJson = System.Text.Json.JsonSerializer.Serialize(Model.ExistingFabrics.Select(f => f.FabricId));
                }
                        const existingIds = @Html.Raw(existingIdsJson);
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            function esc(s) {
                if (!s) return '';
                const d = document.createElement('div');
                d.textContent = String(s);
                return d.innerHTML;
            }

            // ============ Alternate codes (comma-separated) ============
            const altContainer = document.getElementById('altCodeContainer');
            const altCsv = document.getElementById('altCodesCsv');
            function altCodes() {
                const vals = [];
                altContainer.querySelectorAll('input.alt-input').forEach(function(inp) {
                    const v = inp.value.trim();
                    if (v) vals.push(v);
                });
                return vals;
            }
            function syncAltCsv() { altCsv.value = altCodes().join(','); }
            function addAltRow(value) {
                const div = document.createElement('div');
                div.className = 'row g-2 mb-2 align-items-center alt-code-row';
                div.innerHTML =
                    '<div class="col-md-6"><input class="form-control alt-input" placeholder="Alternate code" value="' + (value || '').replace(/"/g, '&quot;') + '" /></div>' +
                    '<div class="col-md-1 d-grid"><button type="button" class="btn btn-outline-danger btn-sm remove-alt"><span class="bi bi-x"></span></button></div>';
                div.querySelector('.alt-input').addEventListener('input', syncAltCsv);
                div.querySelector('.remove-alt').addEventListener('click', function() { div.remove(); syncAltCsv(); });
                altContainer.appendChild(div);
            }
            function renderAltCodes() {
                altContainer.innerHTML = '';
                const initial = (altCsv.value || '').split(',').map(s => s.trim()).filter(Boolean);
                if (!initial.length) initial.push('');
                initial.forEach(function(code) { addAltRow(code); });
                syncAltCsv();
            }
            document.getElementById('addAltCode').addEventListener('click', function() { addAltRow(''); syncAltCsv(); });
            renderAltCodes();

            // ============ New fabrics to add (staged) ============
            const newRowsEl = document.getElementById('newFabricRows');
            const newHint = document.getElementById('newFabricHint');
            let newFabrics = [];        // existing fabrics newly linked: { id, code, qty }
            let stagedNewFabrics = [];  // brand-new fabrics to create: { fabric:{...}, quantityUsed }

            function renderNewFabrics() {
                newRowsEl.innerHTML = '';
                newHint.classList.toggle('d-none', newFabrics.length > 0);
                newFabrics.forEach(function(s, idx) {
                    const row = document.createElement('div');
                    row.className = 'row g-2 mb-2 align-items-center';
                    row.innerHTML =
                        '<div class="col-md-5"><span class="badge text-bg-secondary">' + esc(s.code) + '</span> <span class="badge text-bg-light border">' + esc(s.color || '') + '</span></div>' +
                        '<div class="col-md-3"><input type="number" step="0.01" min="0" class="form-control form-control-sm nf-qty" value="' + (s.qty || '') + '" placeholder="Qty used" /></div>' +
                        '<div class="col-md-1 d-grid"><button type="button" class="btn btn-outline-danger btn-sm nf-remove"><span class="bi bi-x"></span></button></div>';
                    row.querySelector('.nf-qty').addEventListener('input', function(e) { s.qty = e.target.value; });
                    row.querySelector('.nf-remove').addEventListener('click', function() {
                        newFabrics.splice(idx, 1);
                        renderNewFabrics();
                    });
                    newRowsEl.appendChild(row);
                });
            }

            function isExisting(id) { return (existingIds || []).indexOf(id) >= 0; }

            // ---- Fabric picker sidebar: click a fabric code, see ALL its colors, set qty + Add each ----
            const pickerOffcanvasEl = document.getElementById('fabricPickerOffcanvas');
            const openFabricPickerBtn = document.getElementById('openFabricPicker');

            // The whole "Add More Fabrics" block is only rendered while Cutting has NOT
            // started. Guard every lookup so the rest of this script (and buildFabricJson)
            // still runs when the section is absent.
            if (pickerOffcanvasEl && openFabricPickerBtn) {

                const pickerOffcanvas = new bootstrap.Offcanvas(pickerOffcanvasEl);
                const pickerSearch = document.getElementById('fabricPickerSearch');
                const pickerList = document.getElementById('fabricPickerList');
                let openGroupCode = null;

                function addFabric(f, qty) {
                    if (isExisting(f.id) || newFabrics.some(n => n.id === f.id)) {
                        showToast('That fabric color is already linked to this article.', 'warning');
                        return;
                    }
                    newFabrics.push({ id: f.id, code: f.fabricCode, color: f.color, unit: f.unit, qty: qty || '' });
                    renderNewFabrics();
                }

                function groupedFabrics(query) {
                    const q = (query || '').trim().toLowerCase();
                    const pool = fabrics.filter(f => !isExisting(f.id));
                    const filtered = !q ? pool : pool.filter(f =>
                        f.fabricCode.toLowerCase().includes(q) ||
                        (f.color || '').toLowerCase().includes(q) ||
                        (f.fabricType || '').toLowerCase().includes(q) ||
                        (f.invNum || '').toLowerCase().includes(q));
                    const map = {};
                    filtered.forEach(function(f) { (map[f.fabricCode] ||= []).push(f); });
                    return Object.entries(map);
                }

                function renderPicker() {
                    const groups = groupedFabrics(pickerSearch.value);
                    pickerList.innerHTML = '';
                    if (!groups.length) {
                        pickerList.innerHTML = '<div class="text-muted small p-3">No fabrics found.</div>';
                        return;
                    }
                    groups.forEach(function([code, variants]) {
                        const isOpen = openGroupCode === code;
                        const header = document.createElement('button');
                        header.type = 'button';
                        header.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                        header.innerHTML = '<span>' + esc(code) + '</span>' +
                            '<span class="text-muted small">' + esc(variants[0].fabricType || '') + ' · ' + variants.length + ' color(s) ' +
                            '<span class="bi bi-chevron-' + (isOpen ? 'up' : 'down') + '"></span></span>';
                        header.addEventListener('click', function() {
                            openGroupCode = isOpen ? null : code;
                            renderPicker();
                        });
                        pickerList.appendChild(header);

                        if (!isOpen) return;

                        variants.forEach(function(f) {
                            const already = newFabrics.some(n => n.id === f.id);
                            const row = document.createElement('div');
                            row.className = 'p-2 border-bottom bg-body-tertiary';
                            row.innerHTML =
                                '<div class="d-flex justify-content-between align-items-center mb-1">' +
                                '<span class="badge text-bg-light border">' + esc(f.color || 'Unspecified') + '</span>' +
                                '<span class="text-muted small">Avail: ' + f.availableQuantity + ' ' + esc(f.unit) + '</span>' +
                                '</div>' +
                                '<div class="d-flex gap-2">' +
                                '<input type="number" step="0.01" min="0" class="form-control form-control-sm picker-qty" placeholder="Qty used" ' + (already ? 'disabled' : '') + ' />' +
                                '<button type="button" class="btn btn-sm ' + (already ? 'btn-outline-secondary' : 'btn-outline-primary') + ' picker-add flex-shrink-0" ' + (already ? 'disabled' : '') + '>' +
                                (already ? 'Added' : '<span class="bi bi-plus-lg"></span> Add') +
                                '</button>' +
                                '</div>';

                            if (!already) {
                                const qtyInput = row.querySelector('.picker-qty');
                                row.querySelector('.picker-add').addEventListener('click', function() {
                                    const qty = qtyInput.value;
                                    if (!(Number(qty) > 0)) {
                                        showToast('Enter a quantity for ' + (f.color || code) + ' before adding.', 'warning');
                                        return;
                                    }
                                    addFabric(f, qty);
                                    renderPicker();
                                });
                            }
                            pickerList.appendChild(row);
                        });
                    });
                }

                openFabricPickerBtn.addEventListener('click', function() {
                    openGroupCode = null;
                    pickerSearch.value = '';
                    renderPicker();
                    pickerOffcanvas.show();
                });
                pickerSearch.addEventListener('input', renderPicker);

            } // end if (pickerOffcanvasEl && openFabricPickerBtn)

            // ============ Existing fabric qty + remove (staged) ============
            const efTable = document.getElementById('existingFabricsTable');
            const existingQtyJson = document.getElementById('existingQtyJson');
            const removedIdsCsv = document.getElementById('removedFabricIdsCsv');
            const removedIds = [];

            function syncQtyJson() {
                const map = {};
                if (efTable) {
                    efTable.querySelectorAll('tr').forEach(function(tr) {
                        const fid = tr.getAttribute('data-fabric-id');
                        const qty = tr.querySelector('.ef-qty');
                        if (fid && qty) map[fid] = Number(qty.value) || 0;
                    });
                }
                existingQtyJson.value = JSON.stringify(map);
            }

            if (efTable) {
                efTable.querySelectorAll('.ef-qty').forEach(function(inp) {
                    inp.addEventListener('input', syncQtyJson);
                });

                // Removing a linked fabric is confirmed via the app's own modal
                // (same style as the "Confirm Undo" dialog), not the browser's confirm().
                const removeFabricModalEl = document.getElementById('removeFabricModal');
                const removeFabricModal = new bootstrap.Modal(removeFabricModalEl);
                let pendingRemoveTr = null;

                efTable.querySelectorAll('.ef-remove').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        pendingRemoveTr = btn.closest('tr');
                        document.getElementById('removeFabricCode').textContent = pendingRemoveTr.getAttribute('data-code');
                        removeFabricModal.show();
                    });
                });

                document.getElementById('confirmRemoveFabricBtn').addEventListener('click', function() {
                    if (!pendingRemoveTr) return;
                    const fid = Number(pendingRemoveTr.getAttribute('data-fabric-id'));
                    removedIds.push(fid);
                    removedIdsCsv.value = removedIds.join(',');
                    pendingRemoveTr.remove();
                    pendingRemoveTr = null;
                    syncQtyJson();
                    removeFabricModal.hide();
                });

                syncQtyJson();
            }

            // ============ Before submit: build added-fabric + new-fabric JSON ============
            const addedLinksJson = document.getElementById('addedFabricLinksJson');
            const newLinksJson = document.getElementById('newFabricLinksJson');

            // Exposed so the form's inline onsubmit always calls it (robust even if listeners fail).
            // Returns false to block the submit — previously a missing qty was just
            // warned about and silently dropped, and since Save redirects straight to
            // the article detail page, that warning toast was never actually seen and
            // the fabric quietly never got linked.
            window.buildFabricJson = function() {
                const addMap = {};
                const missingQty = [];
                newFabrics.forEach(function(s) {
                    const q = Number(s.qty);
                    if (q > 0) { addMap[s.id] = q; }
                    else { missingQty.push(s.code + (s.color ? ' (' + s.color + ')' : '')); }
                });
                stagedNewFabrics.forEach(function(s) {
                    if (!(Number(s.quantityUsed) > 0)) missingQty.push(s.fabric.code + ' (' + (s.fabric.color || '') + ', new)');
                });

                if (missingQty.length) {
                    if (window.showToast) {
                        showToast('Set a quantity used for: ' + missingQty.join(', ') + ' before saving.', 'danger');
                    }
                    return false;
                }

                addedLinksJson.value = JSON.stringify(addMap);
                // New fabrics to create + link: array of fabric objects + quantityUsed
                newLinksJson.value = JSON.stringify(stagedNewFabrics);

                // Also sync existing qty + removed ids.
                syncQtyJson();
                removedIdsCsv.value = removedIds.join(',');
                return true;
            };

            // ============ Inline Add New Fabric modal ============
            // The trigger button lives inside the same conditional block as the search
            // box (rendered only while Cutting has NOT started), so it can be absent.
            const openFabricModalBtn = document.getElementById('openFabricModal');
            const nfSaveBtn = document.getElementById('nfSave');
            if (openFabricModalBtn && nfSaveBtn) {
                openFabricModalBtn.addEventListener('click', function() {
                    document.getElementById('nfCode').value = '';
                    document.getElementById('nfType').value = '';
                    document.getElementById('nfColor').value = '';
                    document.getElementById('nfInv').value = '';
                    document.getElementById('nfQty').value = '';
                    document.getElementById('nfQtyUsed').value = '';
                    document.getElementById('nfDate').value = new Date().toISOString().slice(0, 10);
                    document.getElementById('nfUnit').value = 'Meter';
                    document.getElementById('nfRate').value = '';
                    document.getElementById('nfError').classList.add('d-none');
                    new bootstrap.Modal(document.getElementById('fabricModal')).show();
                });

                nfSaveBtn.addEventListener('click', function() {
                    const err = document.getElementById('nfError');
                    err.classList.add('d-none');

                    const code = document.getElementById('nfCode').value.trim();
                    const type = document.getElementById('nfType').value.trim();
                    const qty = document.getElementById('nfQty').value;
                    const qtyUsed = document.getElementById('nfQtyUsed').value;
                    if (!code || !type || !document.getElementById('nfColor').value.trim()) {
                        err.textContent = 'Fabric code, type and color are required.';
                        err.classList.remove('d-none');
                        return;
                    }

                    // Stage the new fabric (NOT saved immediately). It becomes linked on Save Changes.
                    stagedNewFabrics.push({
                        fabric: {
                            code: code,
                            invNum: document.getElementById('nfInv').value,
                            date: document.getElementById('nfDate').value,
                            type: type,
                            color: document.getElementById('nfColor').value.trim(),
                            quantity: qty || '0',
                            unit: document.getElementById('nfUnit').value,
                            rate: document.getElementById('nfRate').value || '0'
                        },
                        quantityUsed: qtyUsed || '0'
                    });

                    renderStagedNewFabrics();
                    bootstrap.Modal.getInstance(document.getElementById('fabricModal')).hide();
                });
            } // end if (openFabricModalBtn && nfSaveBtn)

            function renderStagedNewFabrics() {
                const container = document.getElementById('stagedNewFabricRows');
                container.innerHTML = '';
                stagedNewFabrics.forEach(function(s, idx) {
                    const row = document.createElement('div');
                    row.className = 'row g-2 mb-2 align-items-center';
                    row.innerHTML =
                        '<div class="col-md-4"><span class="badge text-bg-success">' + esc(s.fabric.code) + '</span> <span class="text-muted small">(new)</span></div>' +
                        '<div class="col-md-3 text-muted small">Qty used: ' + esc(s.quantityUsed) + '</div>' +
                        '<div class="col-md-1 d-grid"><button type="button" class="btn btn-outline-danger btn-sm snf-remove"><span class="bi bi-x"></span></button></div>';
                    row.querySelector('.snf-remove').addEventListener('click', function() {
                        stagedNewFabrics.splice(idx, 1);
                        renderStagedNewFabrics();
                    });
                    container.appendChild(row);
                });
            }
        })();
    </script>
}

<!-- Select Fabric sidebar: pick a fabric code, see all its colors, set qty + Add -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="fabricPickerOffcanvas" aria-labelledby="fabricPickerLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="fabricPickerLabel">Select Fabric</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
        <div class="p-3 border-bottom">
            <input type="text" class="form-control form-control-sm" id="fabricPickerSearch" placeholder="Search by code / type / invoice..." autocomplete="off" />
        </div>
        <div class="flex-grow-1 overflow-auto" id="fabricPickerList"></div>
    </div>
</div>

<!-- Remove fabric confirmation modal (matches the app's "Confirm Undo" style) -->
<div class="modal fade" id="removeFabricModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Remove Fabric</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Remove fabric <strong id="removeFabricCode"></strong> from this article?</p>
                <p class="text-muted small mt-2 mb-0">Its used quantity will be returned to stock on Save.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmRemoveFabricBtn">
                    <span class="bi bi-x-lg me-1"></span>Yes, Remove
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Fabric creation modal -->
<div class="modal fade" id="fabricModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Fabric</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">Fabric Code <span class="text-danger">*</span></label>
                        <input class="form-control" id="nfCode" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fabric Type <span class="text-danger">*</span></label>
                        <input class="form-control" id="nfType" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Invoice #</label>
                        <input class="form-control" id="nfInv" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fabric Date</label>
                        <input type="date" class="form-control" id="nfDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fabric Color <span class="text-danger">*</span></label>
                        <input class="form-control" id="nfColor" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Unit</label>
                        <select class="form-select" id="nfUnit">
                            <option>Meter</option>
                            <option>Yard</option>
                            <option>Kg</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Quantity</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="nfQty" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Rate</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="nfRate" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Quantity Used for this Article</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="nfQtyUsed" placeholder="How much will be used?" />
                    </div>
                </div>
                <div class="alert alert-danger d-none mt-2" id="nfError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="nfSave"><span class="bi bi-check-lg"></span> Add Fabric</button>
            </div>
        </div>
    </div>
</div>
