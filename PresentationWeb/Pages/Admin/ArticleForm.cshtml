@page
@model ArticleFormModel
@{
    ViewData["Title"] = "Add Article";
    var seasons = new[] { "Summer", "Winter", "Spring", "Autumn" };
}

@await Html.PartialAsync("_Navbar")
@Html.AntiForgeryToken()

<div class="container-fluid px-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Add Article</h4>
        <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm"><span class="bi bi-arrow-left"></span> Back to Dashboard</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post" onsubmit="window.buildFabricJson && window.buildFabricJson();">
                <input type="hidden" asp-for="FabricLinksJson" id="fabricLinksJson" />
                <input type="hidden" asp-for="NewFabricLinksJson" id="newFabricLinksJson" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Company Name <span class="text-danger">*</span></label>
                        <input asp-for="Input.CompanyName" class="form-control" required />
                        <span asp-validation-for="Input.CompanyName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Article Code <span class="text-danger">*</span></label>
                        <input asp-for="Input.ArticleCode" class="form-control" required />
                        <span asp-validation-for="Input.ArticleCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Colour</label>
                        <input asp-for="Input.Color" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Order Date</label>
                        <input asp-for="Input.OrderDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Delivery Date <span class="text-danger">*</span></label>
                        <input asp-for="Input.DeliveryDate" type="date" class="form-control" required min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Input.DeliveryDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Season</label>
                        <select asp-for="Input.Season" class="form-select">
                            <option value="">Select season</option>
                            @foreach (var s in seasons)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Quantity</label>
                        <input asp-for="Input.Quantity" type="number" min="0" class="form-control" placeholder="Optional" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Price Per Piece</label>
                        <input asp-for="Input.PricePerPiece" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label d-block mb-2">Embellishments</label>
                        <div class="form-check form-check-inline">
                            <input asp-for="Input.EmbellishmentPrinting" class="form-check-input" />
                            <label class="form-check-label" asp-for="Input.EmbellishmentPrinting">Printing</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input asp-for="Input.EmbellishmentEmbroidery" class="form-check-input" />
                            <label class="form-check-label" asp-for="Input.EmbellishmentEmbroidery">Embroidery</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input asp-for="Input.EmbellishmentHandwork" class="form-check-input" />
                            <label class="form-check-label" asp-for="Input.EmbellishmentHandwork">Hand Work</label>
                        </div>
                    </div>

                    <!-- Fabrics -->
                    <div class="col-md-12">
                        <label class="form-label d-block mb-2">Link Fabrics (optional)</label>

                        <div class="row g-2 mb-2 align-items-center">
                            <div class="col-md-7">
                                <div class="position-relative">
                                    <input type="text" class="form-control" id="fabricSearch" placeholder="Search existing fabric by code / type / invoice..." autocomplete="off" />
                                    <div class="list-group position-absolute w-100 d-none" id="fabricSuggestions" style="z-index:1050; max-height:220px; overflow-y:auto;"></div>
                                </div>
                            </div>
                            <div class="col-md-5 d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm" id="addSelectedFabric">
                                    <span class="bi bi-plus-lg"></span> Add Selected
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm" id="openFabricModal">
                                    <span class="bi bi-patch-plus"></span> Add New Fabric
                                </button>
                            </div>
                        </div>

                        <div id="selectedFabricRows"></div>
                        <div id="stagedNewFabricRows"></div>
                        <div class="text-muted small" id="noFabricsMsg">No fabrics linked yet.</div>
                    </div>

                    <!-- Department Flow -->
                    <div class="col-md-12">
                        <label class="form-label d-block mb-2">Department Flow <span class="text-danger">*</span></label>
                        <div class="text-muted small mb-2">
                            Select the departments this article must pass through, and their order. Checking an embellishment above adds that department automatically.
                        </div>

                        <!-- hidden: the selected department order (posted to Input.DepartmentOrder) -->
                        <div id="deptOrderHidden"></div>

                        <div class="row g-3">
                            <!-- Available -->
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header py-2">Available</div>
                                    <div class="card-body p-2">
                                        <div id="deptAvailable" class="list-group" style="max-height:260px; overflow-y:auto;"></div>
                                        <div class="text-muted small p-2 d-none" id="deptAvailableEmpty">No departments available.</div>
                                    </div>
                                </div>
                            </div>
                            <!-- Selected -->
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header py-2 d-flex justify-content-between align-items-center">
                                        <span>Selected (in order)</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnSetDefault">Set As It Is</button>
                                    </div>
                                    <div class="card-body p-2">
                                        <div id="deptSelected" class="list-group" style="max-height:260px; overflow-y:auto;"></div>
                                        <div class="text-muted small p-2 d-none" id="deptSelectedEmpty">No departments selected.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <span class="bi bi-check-lg me-1"></span>Create Article
                        </button>
                        <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        @{
            var fabricsJson = System.Text.Json.JsonSerializer.Serialize(
                Model.Fabrics.Select(f => new { f.Id, f.FabricCode, f.FabricType, f.InvNum, f.Unit, f.AvailableQuantity }),
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
        }
        const fabrics = @Html.Raw(fabricsJson);
        @{
            var deptsJson = System.Text.Json.JsonSerializer.Serialize(
                Model.Departments.Select(d => new { d.Id, d.Name, d.Type, d.OrderIndex }),
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
        }
        const departments = @Html.Raw(deptsJson);

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        // ---- Selected fabrics (posted with article) ----
        const selectedContainer = document.getElementById('selectedFabricRows');
        const noFabricsMsg = document.getElementById('noFabricsMsg');
        let selected = [];  // { id, code, unit, qty }

        function renderSelected() {
            selectedContainer.innerHTML = '';
            noFabricsMsg.classList.toggle('d-none', selected.length > 0);

            selected.forEach((s, idx) => {
                const row = document.createElement('div');
                row.className = 'row g-2 mb-2 align-items-center fabric-row';
                row.innerHTML =
                    '<div class="col-md-5">' +
                        '<span class="badge text-bg-secondary">' + esc(s.code) + '</span> <span class="badge text-bg-light border">' + esc(s.color || '') + '</span> ' +
                        '<span class="text-muted small">(Avail: ' + s.avail + ' ' + s.unit + ')</span>' +
                    '</div>' +
                    '<div class="col-md-3">' +
                        '<input type="number" step="0.01" min="0" class="form-control form-control-sm qty-input" placeholder="Qty used" value="' + (s.qty || '') + '" />' +
                    '</div>' +
                    '<div class="col-md-2 d-grid">' +
                        '<button type="button" class="btn btn-outline-danger btn-sm remove-fabric"><span class="bi bi-x"></span></button>' +
                    '</div>';

                row.querySelector('.qty-input').addEventListener('input', function (e) {
                    s.qty = e.target.value || '0';
                });
                row.querySelector('.remove-fabric').addEventListener('click', function () {
                    selected.splice(idx, 1);
                    renderSelected();
                });

                selectedContainer.appendChild(row);
            });
        }

        // ---- Searchable picker ----
        const searchInput = document.getElementById('fabricSearch');
        const suggestions = document.getElementById('fabricSuggestions');
        let activeFabrics = [];

        function filter() {
            const q = searchInput.value.trim().toLowerCase();
            activeFabrics = fabrics.filter(f =>
                !selected.some(s => s.id === f.id) &&
                (f.fabricCode.toLowerCase().includes(q) ||
                 (f.fabricType || '').toLowerCase().includes(q) ||
                 (f.invNum || '').toLowerCase().includes(q)));
            renderSuggestions();
        }

        function renderSuggestions() {
            suggestions.innerHTML = '';
            if (!activeFabrics.length) {
                suggestions.classList.add('d-none');
                return;
            }
            const groups = Object.values(activeFabrics.reduce((map, f) => {
                (map[f.fabricCode] ||= []).push(f); return map;
            }, {}));
            groups.slice(0, 8).forEach(group => {
                const first = group[0];
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'list-group-item list-group-item-action d-flex justify-content-between';
                btn.innerHTML = '<span>' + esc(first.fabricCode) + '</span>' +
                    '<span class="text-muted small">' + esc(first.fabricType || '') + ' · ' + group.length + ' color(s)</span>';
                btn.addEventListener('click', () => renderColorChoices(group));
                suggestions.appendChild(btn);
            });
            suggestions.classList.remove('d-none');
        }

        function renderColorChoices(group) {
            suggestions.innerHTML = '<div class="list-group-item text-muted small">Select fabric color</div>';
            group.forEach(f => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'list-group-item list-group-item-action d-flex justify-content-between';
                btn.innerHTML = '<strong>' + esc(f.color) + '</strong><span class="text-muted small">' + f.availableQuantity + ' ' + esc(f.unit) + '</span>';
                btn.addEventListener('click', () => selectFabric(f));
                suggestions.appendChild(btn);
            });
            suggestions.classList.remove('d-none');
        }

        function selectFabric(f) {
            if (!selected.some(s => s.id === f.id)) {
                selected.push({ id: f.id, code: f.fabricCode, color: f.color, unit: f.unit, avail: f.availableQuantity, qty: '' });
                renderSelected();
            }
            searchInput.value = '';
            suggestions.classList.add('d-none');
        }

        searchInput.addEventListener('input', filter);
        searchInput.addEventListener('focus', () => { if (activeFabrics.length) suggestions.classList.remove('d-none'); });
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.position-relative')) suggestions.classList.add('d-none');
        });

        document.getElementById('addSelectedFabric').addEventListener('click', function () {
            const q = searchInput.value.trim().toLowerCase();
            const match = fabrics.find(f => f.fabricCode.toLowerCase() === q);
            if (match) { selectFabric(match); }
            else { showToast('No matching fabric found. Type a code and pick from the list, or use "Add New Fabric".', 'warning'); }
        });

        // ---- Add New Fabric: create master immediately, then stage the link ----
        let stagedNewFabrics = [];

        document.getElementById('openFabricModal').addEventListener('click', function () {
            document.getElementById('nfCode').value = '';
            document.getElementById('nfType').value = '';
            document.getElementById('nfColor').value = '';
            document.getElementById('nfInv').value = '';
            document.getElementById('nfQty').value = '';
            document.getElementById('nfQtyUsed').value = '';
            document.getElementById('nfDate').value = new Date().toISOString().slice(0, 10);
            document.getElementById('nfUnit').value = 'Meter';
            document.getElementById('nfRate').value = '';
            document.getElementById('nfError').classList.add('d-none');
            new bootstrap.Modal(document.getElementById('fabricModal')).show();
        });

        document.getElementById('nfSave').addEventListener('click', async function () {
            const err = document.getElementById('nfError');
            err.classList.add('d-none');

            const code = document.getElementById('nfCode').value.trim();
            const type = document.getElementById('nfType').value.trim();
            if (!code || !type || !document.getElementById('nfColor').value.trim()) {
                err.textContent = 'Fabric code, type and color are required.';
                err.classList.remove('d-none');
                return;
            }

            // 1) Create the fabric master record immediately via the API.
            const body = new URLSearchParams();
            body.append('NewFabric.FabricCode', code);
            body.append('NewFabric.FabricType', type);
            body.append('NewFabric.Color', document.getElementById('nfColor').value);
            body.append('NewFabric.InvNum', document.getElementById('nfInv').value);
            body.append('NewFabric.FabricDate', document.getElementById('nfDate').value);
            body.append('NewFabric.Quantity', document.getElementById('nfQty').value || '0');
            body.append('NewFabric.Unit', document.getElementById('nfUnit').value);
            body.append('NewFabric.Rate', document.getElementById('nfRate').value || '0');

            const res = await fetch('@Url.Page("ArticleForm", "AddFabric")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: body.toString()
            });
            const data = await res.json();

            if (!data.success) {
                err.textContent = data.message || 'Could not create fabric.';
                err.classList.remove('d-none');
                return;
            }

            // 2) Stage the created fabric so it links to the article on Create Article.
            const qtyUsed = document.getElementById('nfQtyUsed').value || '0';
            if (!stagedNewFabrics.some(s => s.id === data.id)) {
                stagedNewFabrics.push({ id: data.id, code: data.fabricCode, color: data.color, quantityUsed: qtyUsed });
            }
            renderStagedNewFabrics();

            bootstrap.Modal.getInstance(document.getElementById('fabricModal')).hide();
            showToast('Fabric created. It will be linked to the article on Create Article.', 'success');
        });

        function renderStagedNewFabrics() {
            const container = document.getElementById('stagedNewFabricRows');
            container.innerHTML = '';
            stagedNewFabrics.forEach(function (s, idx) {
                const row = document.createElement('div');
                row.className = 'row g-2 mb-2 align-items-center';
                row.innerHTML =
                    '<div class="col-md-4"><span class="badge text-bg-success">' + esc(s.code) + '</span> <span class="text-muted small">(new)</span></div>' +
                    '<div class="col-md-3 text-muted small">Qty used: ' + esc(s.quantityUsed) + '</div>' +
                    '<div class="col-md-1 d-grid"><button type="button" class="btn btn-outline-danger btn-sm snf-remove"><span class="bi bi-x"></span></button></div>';
                row.querySelector('.snf-remove').addEventListener('click', function () {
                    stagedNewFabrics.splice(idx, 1);
                    renderStagedNewFabrics();
                });
                container.appendChild(row);
            });
        }

        // ---- Before submit: build fabric link JSON (inline onsubmit on the form) ----
        // Both searched existing fabrics AND newly-created fabrics go into FabricLinksJson
        // ({fabricId: qty}). New fabrics were already created as master records on "Add New Fabric",
        // so nothing goes into NewFabricLinksJson here.
        const fabricLinksJson = document.getElementById('fabricLinksJson');
        const newLinksJson = document.getElementById('newFabricLinksJson');
        window.buildFabricJson = function () {
            const map = {};
            selected.forEach(function (s) {
                const q = Number(s.qty);
                if (q > 0) map[s.id] = q;
            });
            stagedNewFabrics.forEach(function (s) {
                const q = Number(s.quantityUsed);
                if (q > 0) map[s.id] = q;
            });
            fabricLinksJson.value = JSON.stringify(map);
            newLinksJson.value = '';
        };

        // ---- Utilities ----
        function esc(s) {
            if (!s) return '';
            const d = document.createElement('div');
            d.textContent = String(s);
            return d.innerHTML;
        }

        renderSelected();

        // ===================== Department Flow =====================
        const DEPT_TYPE = {
            Printing: 'Printing',
            Embroidery: 'Embroidery',
            HandWork: 'HandWork'
        };

        let deptSelected = [];   // array of department ids, in order

        // Is this department type gated by an embellishment checkbox?
        function embellDeptType(t) {
            if (t === DEPT_TYPE.Printing) return 'printing';
            if (t === DEPT_TYPE.Embroidery) return 'embroidery';
            if (t === DEPT_TYPE.HandWork) return 'handwork';
            return null;
        }

        // Compute default flow: always-included departments + currently-checked embellishments, in OrderIndex order.
        function defaultFlow() {
            const printing = document.getElementById('Input_EmbellishmentPrinting').checked;
            const embroidery = document.getElementById('Input_EmbellishmentEmbroidery').checked;
            const handwork = document.getElementById('Input_EmbellishmentHandwork').checked;

            return departments
                .filter(d => {
                    const gate = embellDeptType(d.type);
                    if (gate === 'printing') return printing;
                    if (gate === 'embroidery') return embroidery;
                    if (gate === 'handwork') return handwork;
                    return true; // always included
                })
                .sort((a, b) => a.orderIndex - b.orderIndex)
                .map(d => d.id);
        }

        function renderDeptFlow() {
            // Available = all departments not in selected AND whose gate (embellishment) is active
            const avail = departments.filter(d => !deptSelected.includes(d.id) && isDeptGateActive(d));

            const availEl = document.getElementById('deptAvailable');
            availEl.innerHTML = '';
            document.getElementById('deptAvailableEmpty').classList.toggle('d-none', avail.length > 0);
            avail.forEach(d => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                btn.innerHTML = '<span>' + esc(d.name) + '</span><span class="bi bi-plus-lg text-muted"></span>';
                btn.addEventListener('click', function () {
                    if (!deptSelected.includes(d.id)) {
                        deptSelected.push(d.id);
                        renderDeptFlow();
                    }
                });
                availEl.appendChild(btn);
            });

            const selEl = document.getElementById('deptSelected');
            selEl.innerHTML = '';
            document.getElementById('deptSelectedEmpty').classList.toggle('d-none', deptSelected.length > 0);

            deptSelected.forEach((id, idx) => {
                const d = departments.find(x => x.id === id);
                if (!d) return;
                const row = document.createElement('div');
                row.className = 'list-group-item d-flex align-items-center gap-2 dept-row';
                row.draggable = true;
                row.dataset.idx = idx;
                row.innerHTML =
                    '<span class="badge text-bg-dark">' + (idx + 1) + '</span>' +
                    '<span class="flex-grow-1">' + esc(d.name) + '</span>' +
                    '<span class="bi bi-grip-vertical text-muted" title="Hold & slide to reorder"></span>' +
                    '<button type="button" class="btn btn-sm btn-outline-danger dept-remove" title="Remove"><span class="bi bi-x"></span></button>';

                row.querySelector('.dept-remove').addEventListener('click', function () {
                    deptSelected.splice(idx, 1);
                    renderDeptFlow();
                });

                row.addEventListener('dragstart', handleDragStart);
                row.addEventListener('dragover', handleDragOver);
                row.addEventListener('drop', handleDrop);
                row.addEventListener('dragend', handleDragEnd);

                selEl.appendChild(row);
            });

            // emit hidden order inputs
            const hidden = document.getElementById('deptOrderHidden');
            hidden.innerHTML = '';
            deptSelected.forEach((id, i) => {
                const inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'Input.DepartmentOrder[' + i + ']';
                inp.value = id;
                hidden.appendChild(inp);
            });
        }

        // Is an embellishment-gated department currently allowed (its checkbox ticked)?
        function isDeptGateActive(d) {
            const gate = embellDeptType(d.type);
            if (!gate) return true; // always-included departments
            const el = document.getElementById(gate === 'printing' ? 'Input_EmbellishmentPrinting'
                : gate === 'embroidery' ? 'Input_EmbellishmentEmbroidery' : 'Input_EmbellishmentHandwork');
            return el.checked;
        }

        // ---- Drag-to-reorder (native HTML5) ----
        let dragFrom = null;

        function handleDragStart(e) {
            dragFrom = Number(e.currentTarget.dataset.idx);
            e.currentTarget.classList.add('drag-over');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', String(dragFrom));
        }

        function handleDragOver(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            e.currentTarget.classList.add('drag-over');
        }

        function handleDrop(e) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            if (dragFrom === null) return;
            const to = Number(e.currentTarget.dataset.idx);
            if (to !== dragFrom) {
                const [moved] = deptSelected.splice(dragFrom, 1);
                deptSelected.splice(to, 0, moved);
            }
            dragFrom = null;
            renderDeptFlow();
        }

        function handleDragEnd(e) {
            e.currentTarget.classList.remove('drag-over');
            dragFrom = null;
        }

        // Embellishment checkboxes auto-add/remove their department
        ['Input_EmbellishmentPrinting', 'Input_EmbellishmentEmbroidery', 'Input_EmbellishmentHandwork'].forEach(id => {
            document.getElementById(id).addEventListener('change', function () {
                const type = id === 'Input_EmbellishmentPrinting' ? DEPT_TYPE.Printing
                    : id === 'Input_EmbellishmentEmbroidery' ? DEPT_TYPE.Embroidery : DEPT_TYPE.HandWork;
                const dept = departments.find(d => d.type === type);
                if (this.checked) {
                    if (dept && !deptSelected.includes(dept.id)) { deptSelected.push(dept.id); renderDeptFlow(); }
                } else {
                    if (dept) { deptSelected = deptSelected.filter(x => x !== dept.id); renderDeptFlow(); }
                }
            });
        });

        // "Set As It Is" -> default flow
        document.getElementById('btnSetDefault').addEventListener('click', function () {
            deptSelected = defaultFlow();
            renderDeptFlow();
        });

        // Initialize: preserve a posted custom order if present, else default flow.
        const postedOrder = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Input.DepartmentOrder ?? new List<int>(),
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        deptSelected = (postedOrder && postedOrder.length > 0)
            ? postedOrder.filter(id => departments.some(d => d.id === id))
            : defaultFlow();
        renderDeptFlow();
    })();
</script>
}

<!-- Fabric creation modal -->
<div class="modal fade" id="fabricModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Fabric</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">Fabric Code <span class="text-danger">*</span></label>
                        <input class="form-control" id="nfCode" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fabric Type <span class="text-danger">*</span></label>
                        <input class="form-control" id="nfType" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Invoice #</label>
                        <input class="form-control" id="nfInv" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fabric Date</label>
                        <input type="date" class="form-control" id="nfDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fabric Color <span class="text-danger">*</span></label>
                        <input class="form-control" id="nfColor" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Unit</label>
                        <select class="form-select" id="nfUnit">
                            <option>Meter</option><option>Yard</option><option>Kg</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Quantity</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="nfQty" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Rate</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="nfRate" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Quantity Used for this Article</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="nfQtyUsed" placeholder="How much of this fabric is used?" />
                    </div>
                </div>
                <div class="alert alert-danger d-none mt-2" id="nfError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="nfSave"><span class="bi bi-check-lg"></span> Add Fabric</button>
            </div>
        </div>
    </div>
</div>
