@page "/Admin/Fabrics"
@model FabricsModel
@{
    ViewData["Title"] = "Fabrics";
    var units = new[] { "Meter", "Yard", "Kg" };
}

@await Html.PartialAsync("_Navbar")
@Html.AntiForgeryToken()

<div class="container-fluid px-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Fabrics</h4>
        <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm"><span class="bi bi-arrow-left"></span> Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2">@TempData["SuccessMessage"]</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    }

    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card shadow-sm border-success"><div class="card-body py-3">
                <div class="text-muted small">Current Available Stock Value</div>
                <div class="fs-4 fw-bold text-success">Rs. @Model.TotalAvailableStockValue.ToString("N2")</div>
            </div></div>
        </div>
    </div>

    <!-- Add Fabric -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">Add Fabric</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Add">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Fabric Code <span class="text-danger">*</span></label>
                        <input asp-for="AddFabric.FabricCode" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Invoice #</label>
                        <input asp-for="AddFabric.InvNum" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fabric Date</label>
                        <input asp-for="AddFabric.FabricDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fabric Type <span class="text-danger">*</span></label>
                        <input asp-for="AddFabric.FabricType" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fabric Color <span class="text-danger">*</span></label>
                        <input asp-for="AddFabric.Color" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Quantity</label>
                        <input asp-for="AddFabric.Quantity" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Unit</label>
                        <select asp-for="AddFabric.Unit" class="form-select">
                            @foreach (var u in units)
                            {
                                <option value="@u">@u</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Rate</label>
                        <input asp-for="AddFabric.Rate" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100"><span class="bi bi-plus-lg"></span> Create Fabric</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-5">
                    <input type="text" class="form-control" id="fabricSearch" placeholder="Search by code or type..." autocomplete="off" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" id="btnClearSearch">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <!-- In-Stock table -->
    <div class="card shadow-sm">
        <div class="card-header">In-Stock Fabrics</div>
        <div class="card-body table-responsive">
            @if (Model.InStockFabrics.Any())
            {
                <table class="table table-hover align-middle mb-0" id="fabricTable">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Inv #</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Color</th>
                            <th>Total Purchased</th>
                            <th>Available</th>
                            <th>Rate</th>
                            <th>Total Amount</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Model.InStockFabrics.GroupBy(f => f.FabricCode))
                        {
                            var variants = group.OrderBy(f => f.Color).ToList();
                            for (var i = 0; i < variants.Count; i++)
                            {
                                var f = variants[i];
                                <tr data-search="@($"{f.FabricCode} {f.FabricType} {f.Color}")">
                                    @if (i == 0)
                                    {
                                        <td class="fw-semibold align-top" rowspan="@variants.Count">@f.FabricCode<br/><span class="badge text-bg-secondary">@variants.Count color(s)</span></td>
                                        <td class="align-top" rowspan="@variants.Count">@(f.InvNum ?? "—")</td>
                                        <td class="align-top" rowspan="@variants.Count">@(f.FabricDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                        <td class="align-top" rowspan="@variants.Count">@f.FabricType</td>
                                    }
                                    <td><span class="badge text-bg-light border">@f.Color</span></td>
                                    <td>@f.Quantity @f.Unit</td>
                                    <td class="fw-semibold text-success">@f.AvailableQuantity @f.Unit</td>
                                    <td>@f.Rate.ToString("N2")</td>
                                    <td>@f.TotalAmount.ToString("N2")</td>
                                    <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary topup-btn"
                                        data-id="@f.Id" data-code="@f.FabricCode — @f.Color" data-avail="@f.AvailableQuantity"
                                        data-unit="@f.Unit" data-rate="@f.Rate"><span class="bi bi-arrow-up-circle"></span> Top Up</button></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No fabrics in stock. Use the search box to find and top up out-of-stock fabrics, or add a new one above.</p>
            }
        </div>
    </div>
</div>

<!-- Top Up modal -->
<div class="modal fade" id="topUpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="TopUp">
                <input type="hidden" asp-for="TopUp.FabricId" id="tuFabricId" />
                <div class="modal-header">
                    <h5 class="modal-title">Top Up Fabric — <span id="tuCode"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="text-muted small mb-3">
                        Current available: <strong id="tuAvail"></strong> · Current rate: <strong id="tuRate"></strong>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Additional Quantity <span class="text-danger">*</span></label>
                        <input asp-for="TopUp.AddedQuantity" type="number" step="0.01" min="0.01" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Rate (optional)</label>
                        <input asp-for="TopUp.NewRate" type="number" step="0.01" min="0" class="form-control" placeholder="Leave blank to keep current rate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><span class="bi bi-arrow-up-circle"></span> Top Up</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const table = document.getElementById('fabricTable');
            const search = document.getElementById('fabricSearch');

            if (table) {
                const rows = table.querySelectorAll('tbody tr');
                search.addEventListener('input', function () {
                    const q = search.value.trim().toLowerCase();
                    rows.forEach(function (tr) {
                        const hay = (tr.getAttribute('data-search') || '').toLowerCase();
                        tr.style.display = (!q || hay.includes(q)) ? '' : 'none';
                    });
                });
            }

            document.getElementById('btnClearSearch').addEventListener('click', function () {
                search.value = '';
                search.dispatchEvent(new Event('input'));
            });

            // Top Up modal population
            document.querySelectorAll('.topup-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('tuFabricId').value = btn.getAttribute('data-id');
                    document.getElementById('tuCode').textContent = btn.getAttribute('data-code');
                    document.getElementById('tuAvail').textContent = btn.getAttribute('data-avail') + ' ' + btn.getAttribute('data-unit');
                    document.getElementById('tuRate').textContent = btn.getAttribute('data-rate');
                    new bootstrap.Modal(document.getElementById('topUpModal')).show();
                });
            });
        })();
    </script>
}
